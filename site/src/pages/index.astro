---
// LoopTax results page. Every number below is read from src/data/site.json, which scripts/build-data.mjs builds from
// the repo's results/, toy/ and configs/ at build time. Nothing numeric is typed by hand.
import "../styles/global.css";
import Chart from "../components/Chart.astro";
import site from "../data/site.json";

const S_: any = site;
const L = site.layout;
const loopStart = L.loop["loop.start"], loopEnd = L.loop["loop.end"], passes = L.loop["loop.count"];
const pct = (x: number, d = 1) => `${(100 * x).toFixed(d)}%`;
const f2 = (x: number) => x.toFixed(2);
const f4 = (x: number) => x.toFixed(4);
const variants = (exp: string) => ((S_.experiments[exp] ?? []) as any[]).filter((r) => r.role === "variant");

// toy
const depth = site.toy.depth;
const toyLooped = depth.looped_mean.at(-1), toyDistinct = depth.distinct_mean.at(-1);
const grid = site.toy.grid as { loop_bits: number; edge_bits: number; avg_bits: number; err: number }[];

// controlled test: screening fit (N = 2-5) and held-out confirmation
const S = (S_.alpha ?? []) as any[];
const H = (S_.alphaHoldout ?? []) as any[];
const rng = (rs: any[]) => rs.length ? [Math.min(...rs.map((r) => r.alpha_2to5)), Math.max(...rs.map((r) => r.alpha_2to5))] : null;
const loop25 = rng(S.filter((r) => r.category === "loop" && r.alpha_2to5 != null));
const coda25 = rng(S.filter((r) => r.category === "coda" && r.alpha_2to5 != null));
const hLoop = H.filter((r) => r.category === "loop" && r.alpha_2to5 != null);
const hCoda = H.find((r) => r.category === "coda" && r.alpha_2to5 != null);
const confirmed = hLoop.length > 0 && hCoda != null;
const ci = (r: any) => `[${f2(r.alpha_2to5_ci95[0])}, ${f2(r.alpha_2to5_ci95[1])}]`;

// sensitivity by family
const p2 = variants("phase2-scan");
const attn = p2.filter((r) => r.family === "attn" && r.qtype === "Q2_K");
const experts = p2.filter((r) => r.family === "experts" && r.qtype === "Q2_K");
const topAttn = attn.slice().sort((a, b) => b.kld_mean_avg - a.kld_mean_avg).slice(0, 4).map((r) => r.block).sort((a, b) => a - b);
const exRange = (lo: number, hi: number) => {
  const v = experts.filter((r) => r.block >= lo && r.block < hi).map((r) => r.kld_mean_avg);
  return v.length ? `${f4(Math.min(...v))}-${f4(Math.max(...v))}` : null;
};
const exPrelude = exRange(0, loopStart), exLoop = exRange(loopStart, loopEnd);

// FP4-native weights vs BF16
const bf = variants("bf16check");
const bfN = bf.find((r) => r.variant === "ggml-org-nvfp4");
const bfQ8 = bf.find((r) => r.variant === "q8_0-from-bf16");
const bfQ4 = bf.find((r) => r.variant === "q4_k_m-from-bf16");
// measurement floor: the same NVFP4 file run CPU-only (reference) vs on the GPU (variant)
const floorDev = variants("floor-device")[0], floorCpu = variants("floor-cpu-vs-bf16")[0];
const floor = floorDev?.kld_mean_avg;

// bits vs passes, KL against the shipped model averaged over wikitext and code
const pp = variants("phase4-passes").concat(((S_.experiments["phase4-passes"] ?? []) as any[]).filter((r) => r.role === "reference"));
const vs3 = (v: string, n: number) => {
  const r = pp.find((r) => r.variant === v && r.passes === n);
  return r && r.wikitext_vs3_kld_mean != null ? (r.wikitext_vs3_kld_mean + r.code_vs3_kld_mean) / 2 : null;
};
const q3at3 = vs3("uniform-q3_k", 3), nvAt2 = vs3("reference", 2);

// phase 3 bars to beat
const comm = variants("phase1-community"), base = variants("phase1-baselines");
const ud = comm.find((r) => r.variant === "unsloth-ud-q4_k_m");
const iq4xs = base.find((r) => r.variant === "iq4_xs"), iq4nl = base.find((r) => r.variant === "iq4_nl");
// Phase 3 stays a placeholder until its results are final. Final as of 2026-11-27: under 16 GB screening plus the
// >= 16 GB frontier, which turned out to sit at the measurement floor against BF16 (see section 6).
const phase3Final = true;
const p3 = phase3Final ? variants("phase3") : [];

// architecture diagram geometry
const blocks = Array.from({ length: L.block_count }, (_, i) => i);
const bw = 26, gap = 4, x0 = 10;
const bx = (i: number) => x0 + i * (bw + gap);
const repo = "https://github.com/shubhambaid/loop-tax";
const commit = site.models?.llama_cpp?.commit ?? site.env.llama_cpp_commit;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Is there a loop tax? Quantizing a looped transformer</title>
  <meta name="description" content="Looped transformers reuse the same weights several times per token. We expected their quantization error to compound with every pass. On Inkling 2 Mini, it doesn't." />
  <meta property="og:title" content="Is there a loop tax? On Inkling 2 Mini, reuse does not compound quantization error" />
  <meta property="og:description" content="A controlled test of quantization error across loop passes, where the sensitivity actually sits, and why FP4-trained weights should stay FP4." />
  <meta property="og:url" content="https://looptax.alethic-labs.com/" />
  <meta name="twitter:card" content="summary" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,600;1,6..96,400&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
  <script is:inline>
    const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t;
  </script>
</head>
<body>
<header class="topbar">
  <a class="brand" href="https://alethic-labs.com/">Alethic Labs</a>
  <nav><a href="#tldr">TL;DR</a><a href="#test">The test</a><a href="#fp4">FP4</a><a href="#reproduce">Reproduce</a><a href={repo}>Code</a></nav>
  <button class="theme-toggle" id="theme-toggle" aria-label="Toggle light or dark theme">theme</button>
</header>
<main>
  <section class="hero">
    <div class="kicker">Research note · Inkling 2 Mini · llama.cpp</div>
    <h1>Is there a <em>loop tax</em>?</h1>
    <p class="lede">
      Looped transformers reuse the same weights several times per token. We expected their quantization error to
      compound with every pass. On Inkling 2 Mini, it doesn't.
    </p>
  </section>

  <section id="tldr" class="tldr">
    <h2>TL;DR</h2>
    <ol>
      <li><strong>Reuse does not compound quantization error.</strong> A quantized loop block does about the same damage at
        2 passes as at 5, like control blocks that run once.
        {confirmed && <> Confirmed on held-out text: loop blocks {hLoop.map((r, i) => <>{i ? " and " : ""}{r.block} at N<sup>{f2(r.alpha_2to5)}</sup></>)},
        control block {hCoda.block} at N<sup>{f2(hCoda.alpha_2to5)}</sup>.</>}</li>
      <li><strong>Loop blocks are more sensitive, but because of where they sit, not because they repeat.</strong> The
        sensitive part is attention in a few middle layers, not the experts.</li>
      {bfN && bfQ4 && floor && <li><strong>For a model trained in FP4, keep the native NVFP4 file.</strong>{" "}
        It cannot be told apart from the released weights: its distance from them is below the noise between running the
        same file on CPU and GPU. A same-size Q4_K_M sits {(bfQ4.kld_mean_avg / floor).toFixed(1)}x above that noise.</li>}
    </ol>
  </section>

  <h2><span class="num">1</span>The architecture</h2>
  <p>
    Inkling 2 Mini stores {L.block_count} decoder layers but runs layers {loopStart} to {loopEnd - 1} {passes === 3 ? "three" : passes} times
    per token, {L.visits} layer visits in total. Each pass restarts from the prelude output and receives a gated message
    from the previous pass.
  </p>
  <figure class="wide">
    <svg viewBox={`0 0 ${bx(L.block_count) + 10} 124`} role="img" aria-label={`${L.block_count} stored blocks, blocks ${loopStart} to ${loopEnd - 1} run ${passes} times`} style="width:100%;height:auto">
      {blocks.map((i) => {
        const inLoop = i >= loopStart && i < loopEnd;
        return (
          <g>
            <rect x={bx(i)} y="40" width={bw} height="44" rx="4" fill={inLoop ? "var(--loop)" : "var(--edge)"} opacity={inLoop ? 0.9 : 0.75} />
            <text x={bx(i) + bw / 2} y="100" text-anchor="middle" font-size="9" fill="var(--text-2)">{i}</text>
          </g>
        );
      })}
      <path d={`M ${bx(loopEnd) - gap - 2} 36 C ${bx(loopEnd)} 6, ${bx(loopStart) - 2} 6, ${bx(loopStart) + 2} 36`} fill="none" stroke="var(--text)" stroke-width="1.5" marker-end="url(#arrow)" />
      <text x={(bx(loopStart) + bx(loopEnd)) / 2} y="14" text-anchor="middle" font-size="11" fill="var(--text)">x{passes} passes, shared weights</text>
      <text x={bx(0)} y="118" font-size="10" fill="var(--text-2)">prelude (runs once)</text>
      <text x={bx(loopEnd)} y="118" font-size="10" fill="var(--text-2)">coda (runs once)</text>
      <defs><marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--text)" /></marker></defs>
    </svg>
    <figcaption><strong>{L.block_count} stored blocks, {L.visits} layer visits per token.</strong> Read from the GGUF tensor table: one physical copy of each block, loop controller tensors only in blocks {loopStart}-{loopEnd - 1}.</figcaption>
  </figure>

  <h2><span class="num">2</span>The intuition we tested</h2>
  <p>
    If the same quantized weights are applied three times, the same rounding error is applied three times. In a toy model
    where each pass feeds the next, that error stacks up. This section shows the toy and is clearly a toy: random weights,
    not Inkling.
  </p>
  <p>
    {`At equal depth and 4-bit weights, the looped toy stack ends at ${pct(toyLooped)} hidden-state error against ${pct(toyDistinct)} for distinct blocks.`}
  </p>
  <Chart name="toyDepth" toy title="Error vs layer visits, distinct vs looped blocks"
    caption="20 seeds, 4-bit round-to-nearest. The curves are identical until the loop restarts."
    rows={depth.distinct_mean.map((v: number, i: number) => ({ depth: i + 1, distinct: 100 * v, looped: 100 * depth.looped_mean[i] }))}
    columns={[["depth", "layer visits"], ["distinct", "distinct blocks (%)", 2], ["looped", "looped blocks (%)", 2]]} />
  <Chart name="toyGrid" toy title="Final error by loop bits and edge bits (Inkling-shaped toy)"
    caption="Cells show final hidden-state error in percent; 10 seeds. In the toy, a spare bit is always worth more in the loop."
    rows={grid.map((g) => ({ ...g, errp: 100 * g.err }))}
    columns={[["loop_bits", "loop bits"], ["edge_bits", "edge bits"], ["avg_bits", "average bits", 1], ["errp", "error (%)", 1]]} />

  <h2 id="test"><span class="num">3</span>The controlled test</h2>
  <p>
    On the variable-loop research checkpoint we quantized one block and ran 1 to 5 passes, comparing each run with the
    unquantized model at the same pass count. We fit KL = c · N<sup>α</sup>: α near 2 means errors add coherently, near
    1 independently, near 0 not at all.
    {loop25 && coda25 && <> Loop blocks came out at {f2(loop25[0])} to {f2(loop25[1])} (passes 2 to 5), coda controls at
    {" "}{f2(coda25[0])} to {f2(coda25[1])}.</>} Pass 1 differs from the rest because it has no incoming message, so the
    fit uses passes 2 to 5.
  </p>
  <Chart name="headlineKL" wide title="KL from quantizing one block, by number of loop passes"
    caption="Log-log axes, screening text. Each line is one perturbed block. Pass 6 (hollow) was never trained." />
  <Chart name="alpha" wide title="Fitted exponent α per block, passes 2 to 5"
    caption="Filled: screening text. Hollow: held-out text disjoint from the screening set. Bars are 95% paired bootstrap intervals over evaluation chunks. Dashed lines at 0, 1 and 2."
    rows={[...S.map((r) => ({ ...r, set: "screening" })), ...H.map((r) => ({ ...r, set: "held-out" }))].filter((r) => r.alpha_2to5 != null)}
    columns={[["variant", "variant"], ["set", "text"], ["category", "category"], ["alpha_2to5", "α (N = 2-5)", 2]]} />
  {confirmed && <p class="note">
    Held-out confirmation: {hLoop.map((r, i) => <>{i ? "; " : ""}loop block {r.block} α = {f2(r.alpha_2to5)} {ci(r)}</>)};
    control block {hCoda.block} α = {f2(hCoda.alpha_2to5)} {ci(hCoda)}.
  </p>}

  <h2><span class="num">4</span>Why the intuition fails here</h2>
  <p>
    The toy behaves like an accumulator: every pass adds onto the last. Inkling behaves like a retry loop: every pass
    starts from the same input and only a small gated note carries over. Errors do not get a chance to pile up.
  </p>
  <figure class="wide flow">
    <div class="flow-panel">
      <div class="toy-label">toy simulation, random weights, not Inkling 2 Mini</div>
      <svg viewBox="0 0 400 120" role="img" aria-label="Accumulator: each pass takes the previous pass's output as input">
        <defs><marker id="a2" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--text-2)" /></marker></defs>
        <text x="10" y="64" font-size="12" fill="var(--text)">h</text>
        {[0, 1, 2].map((k) => <>
          <line x1={28 + k * 120} y1="60" x2={68 + k * 120} y2="60" stroke="var(--text-2)" stroke-width="1.5" marker-end="url(#a2)" />
          <rect x={72 + k * 120} y="40" width="64" height="40" rx="6" fill="var(--loop)" opacity="0.9" />
          <text x={104 + k * 120} y="65" text-anchor="middle" font-size="12" fill="#fff">W + e</text>
        </>)}
        <text x="200" y="108" text-anchor="middle" font-size="11" fill="var(--text-2)">output of pass k is the input of pass k+1: e is processed again</text>
      </svg>
      <div class="flow-title">Accumulator (the toy)</div>
    </div>
    <div class="flow-panel">
      <svg viewBox="0 0 400 150" role="img" aria-label="Retry loop: every pass starts from the prelude output, only a gated message carries over">
        <defs><marker id="a3" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--text-2)" /></marker></defs>
        <rect x="6" y="56" width="74" height="40" rx="6" fill="var(--edge)" opacity="0.8" />
        <text x="43" y="80" text-anchor="middle" font-size="11" fill="#fff">prelude</text>
        {[0, 1, 2].map((k) => <>
          <path d={`M 80 76 C 120 76, 130 ${20 + k * 45}, 160 ${30 + k * 45}`} fill="none" stroke="var(--text-2)" stroke-width="1.5" marker-end="url(#a3)" />
          <rect x="164" y={12 + k * 45} width="80" height="36" rx="6" fill="var(--loop)" opacity="0.9" />
          <text x="204" y={35 + k * 45} text-anchor="middle" font-size="11" fill="#fff">pass {k + 1}</text>
        </>)}
        {[0, 1].map((k) => <>
          <path d={`M 244 ${30 + k * 45} C 280 ${34 + k * 45}, 280 ${53 + k * 45}, 248 ${58 + k * 45}`} fill="none" stroke="var(--text-2)" stroke-width="1" stroke-dasharray="3,3" marker-end="url(#a3)" />
          <text x="284" y={48 + k * 45} font-size="10" fill="var(--text-2)">gated note</text>
        </>)}
        <line x1="244" y1="120" x2="300" y2="120" stroke="var(--text-2)" stroke-width="1.5" marker-end="url(#a3)" />
        <text x="306" y="124" font-size="11" fill="var(--text)">coda</text>
        <text x="200" y="146" text-anchor="middle" font-size="11" fill="var(--text-2)">every pass restarts from the same input</text>
      </svg>
      <div class="flow-title">Retry loop (Inkling 2 Mini)</div>
    </div>
  </figure>

  <h2><span class="num">5</span>Where the sensitivity actually is</h2>
  <p>
    A per-layer scan shows the middle layers are more sensitive even when they run once. Breaking it down, experts are
    about equally sensitive in prelude and loop blocks{exPrelude && exLoop && <> (KL {exPrelude} vs {exLoop} at Q2_K)</>};
    attention in a few middle layers (blocks {topAttn.join(", ").replace(/, (\d+)$/, " and $1")}) is what stands out.
  </p>
  <Chart name="phase2" wide title="KL increase when one whole block is quantized"
    caption="Looped blocks highlighted. Screening run, about 16k scored tokens per bar."
    rows={p2.filter((r) => r.family === "block")} columns={[["block", "block"], ["qtype", "type"], ["kld_mean_avg", "mean KL", 5], ["kld_mean_avg_err", "std err", 5]]} />
  <Chart name="family" wide title="Attention only vs experts only, one block at Q2_K"
    caption="Same scan, perturbing only one part of the block. The attention bars carry the middle-layer bump; the expert bars stay flat across prelude and loop."
    rows={[...attn, ...experts]} columns={[["block", "block"], ["family", "part"], ["kld_mean_avg", "mean KL", 5]]} />

  <h2 id="fp4"><span class="num">6</span>FP4-native weights</h2>
  <p>
    The experts were trained with NVFP4 forward passes and released in NVFP4 (MXFP8 for blocks 20-23). The native NVFP4
    file stores those expert values exactly. The BF16 checkpoint is the release upcast to 16 bits, which rounds the
    product of a 4-bit value, an 8-bit block scale and a 32-bit tensor scale, so it is very close to the release but not
    identical. Any K-quant has to move FP4-trained values onto a different grid.
  </p>
  {floor && floorCpu && <p>
    How close is close? Running the very same NVFP4 file on the CPU and on the GPU already gives KL {f4(floor)}: that is
    the noise of llama.cpp's compute paths on this model. The NVFP4 file vs BF16 ({f4(bfN.kld_mean_avg)} on GPU,
    {" "}{f4(floorCpu.kld_mean_avg)} with both on CPU) and Q8_0 vs BF16 ({f4(bfQ8.kld_mean_avg)}) are at that floor, so they
    cannot be ranked against each other. Q4_K_M ({f4(bfQ4.kld_mean_avg)}) is well above it.
  </p>}
  {bfN && bfQ8 && bfQ4 && <div class="stat-row">
    <div class="stat hi"><div class="v">{f4(bfN.kld_mean_avg)}</div><div class="l">NVFP4 file · {bfN.file_gb.toFixed(1)} GB</div></div>
    <div class="stat"><div class="v">{f4(bfQ8.kld_mean_avg)}</div><div class="l">Q8_0 · {bfQ8.file_gb.toFixed(1)} GB</div></div>
    <div class="stat"><div class="v">{f4(bfQ4.kld_mean_avg)}</div><div class="l">Q4_K_M · {bfQ4.file_gb.toFixed(1)} GB</div></div>
  </div>}
  <Chart name="bf16" wide title="Distance from the BF16 weights"
    caption="Mean KL vs BF16 (computed on the CPU) over three domains. Dashed line: the same NVFP4 file run on CPU vs GPU, the measurement floor."
    rows={bf} columns={[["variant", "variant"], ["file_gb", "size (GB)", 2], ["kld_mean_avg", "mean KL vs BF16", 5], ["wikitext_same_top_p_pct", "top-1 agree (%)", 1]]} />

  <h2><span class="num">7</span>Bits vs passes</h2>
  <p>
    {q3at3 != null && nvAt2 != null && <>Against the 3-pass model as shipped, Q3 at 3 passes ({f4(q3at3)} KL) is closer than
    full NVFP4 at 2 passes ({f4(nvAt2)}). </>}Fewer passes is faster, but it costs more quality than fewer bits.
  </p>
  <Chart name="grid" wide title="Fewer bits or fewer passes"
    caption="Each line is one bit width for the gate/up experts; points are 1-5 loop passes. KL against the reference at 3 passes, averaged over wikitext and code."
    rows={pp.filter((r) => ["reference", "uniform-iq4_xs", "uniform-q3_k", "uniform-q2_k"].includes(r.variant))}
    columns={[["variant", "variant"], ["passes", "passes"], ["file_gb", "GB", 2], ["wikitext_vs3_kld_mean", "KL vs shipped (wikitext)", 5], ["code_vs3_kld_mean", "KL vs shipped (code)", 5], ["tg_tps", "decode tok/s", 1]]} />

  <h2><span class="num">8</span>Building a better quant</h2>
  {p3.length === 0 ? (
    <div class="pending">
      <strong>In progress.</strong> Phase 3 results land here when they are in the repo. Bars to beat:
      {ud && <> unsloth UD-Q4_K_M at {ud.file_gb.toFixed(1)} GB for 16 GB and up;</>}
      {iq4xs && iq4nl && <> stock IQ4_XS ({iq4xs.file_gb.toFixed(1)} GB) and IQ4_NL ({iq4nl.file_gb.toFixed(1)} GB) below 16 GB.</>}
    </div>
  ) : (
    <>
    <p>
      Every recipe keeps the down experts at NVFP4 and varies the gate/up experts per block; the 16 GB+ recipes also keep
      all NVFP4 experts and tune attention and the blocks 20-23 experts, built from a source that holds the release's NVFP4
      experts bit for bit and everything else in BF16.
    </p>
    <ul>
      {p3.find((r) => r.variant === "loop-hi-edges-q2_k") && p3.find((r) => r.variant === "edge-hi-loop-q2_k") && <li>
        <strong>Bits in the loop beat bits at the edges, at equal size:</strong> loop blocks at NVFP4 with the rest at Q2_K reach
        KL {f4(p3.find((r) => r.variant === "loop-hi-edges-q2_k")["ref-bf16_kld_mean_avg"])} vs BF16, the mirror image
        {" "}{f4(p3.find((r) => r.variant === "edge-hi-loop-q2_k")["ref-bf16_kld_mean_avg"])}. The loop holds the sensitive middle of
        the network, so this fits the position effect; it does not need reuse to explain it.</li>}
      <li><strong>Below 15 GB, the same type everywhere beats mixing:</strong> uniform IQ3_XXS is better than every recipe that
        mixes Q2_K and NVFP4, at a smaller size. Recipes guided by single-block scans did worst: single-block sensitivities do
        not add up when many blocks are quantized together.</li>
      {ud && floor && <li><strong>At 16 GB and up there is nothing left to win:</strong> unsloth's UD-Q4_K_M, the NVFP4 file and
        all our recipes sit within the measurement floor of the release ({f4(floor)}), so none can be shown to be better than
        another. We are not publishing a "better quant".</li>}
    </ul>
    <Chart name="phase3" wide title="Quality vs size for the Phase 3 recipes"
      caption="Mean KL vs BF16. Dashed line: measurement floor (same file, CPU vs GPU). Grey squares: other GGUFs measured against the same BF16 logits. Screening run, 16 chunks per point."
      rows={p3} columns={[["variant", "recipe"], ["recipe_family", "family"], ["file_gb", "size (GB)", 2], ["ref-bf16_kld_mean_avg", "mean KL vs BF16", 5], ["kld_mean_avg", "mean KL vs NVFP4 file", 5], ["tg_tps", "decode tok/s", 1]]} />
    </>
  )}

  <h2><span class="num">9</span>Limitations</h2>
  <p>
    One model, one machine (Apple M4 Pro, {(site.env.memory_bytes / 2 ** 30).toFixed(0)} GB), KL on
    {" "}{Object.keys(site.evalset).length === 3 ? "three" : Object.keys(site.evalset).length} text domains, no downstream task
    scores. Passes other than 3 were only mid-trained, and pass 6 was never trained.
  </p>

  <h2 id="reproduce"><span class="num">10</span>Reproduce it</h2>
